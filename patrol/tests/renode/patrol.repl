flash: Memory.MappedMemory @ sysbus 0
    size: 0x40000

sram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x8000

nvic: IRQControllers.NVIC @ sysbus 0xe000e000
    priorityMask: 0xe0
    systickFrequency: 80000000
    IRQ -> cpu@0

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m4"
    nvic: nvic

uart1: UART.PL011 @ sysbus 0x4000d000
    -> nvic@6

deviceId: Memory.MappedMemory @ sysbus 0x400fe000
    size: 0x1000
